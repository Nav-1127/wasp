# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email)
RESEND_API_KEY=

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# Token encryption — generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=https://joinwasp.com

# Development / testing
# Set to true to use mock Instagram connection instead of real Meta OAuth
# Automatically active when META_APP_ID is not set
NEXT_PUBLIC_USE_MOCK_AUTH=false
USE_MOCK_AUTH=false
